<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Martabak Medan | Katalog Kuliner</title>

  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --cream: #fff9f1;
      --pink: #f8dfe0;
      --peach: #f5cdbb;
      --brown: #765345;
      --green: #dcebdc;
      --dark: #49352d;
    }

    * {
      box-sizing: border-box;
    }

    body {
      font-family: 'Poppins', sans-serif;
      background: var(--cream);
      color: var(--dark);
    }

    .navbar {
      background: rgba(255,255,255,.95);
      box-shadow: 0 3px 15px #76534512;
    }

    .navbar-brand {
      color: var(--brown);
      font-weight: 800;
      font-size: 23px;
    }

    .hero {
      background: linear-gradient(120deg,#f8dfe0,#fff0dd,#dcebdc);
      border-radius: 0 0 45px 45px;
      padding: 75px 0;
    }

    .hero h1 {
      font-weight: 800;
      color: var(--dark);
      font-size: clamp(32px,5vw,53px);
    }

    .hero p {
      color: #705b50;
      line-height: 1.9;
    }

    .hero-img {
      width: 100%;
      max-height: 340px;
      object-fit: cover;
      border-radius: 28px;
      box-shadow: 0 15px 35px #76534530;
    }

    .soft-btn {
      background: var(--brown);
      color: white;
      border-radius: 30px;
      padding: 12px 25px;
      font-weight: 600;
      border: none;
    }

    .soft-btn:hover {
      background: #54392e;
      color: white;
    }

    .section-title {
      font-weight: 800;
      color: var(--dark);
    }

    .product-card {
      border: none;
      border-radius: 22px;
      overflow: hidden;
      background: white;
      box-shadow: 0 5px 20px #76534512;
      height: 100%;
      transition: .25s;
    }

    .product-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 12px 25px #76534520;
    }

    .product-img {
      width: 100%;
      height: 205px;
      object-fit: cover;
      background: #f7e8dc;
    }

    .product-card .card-body {
      padding: 19px;
    }

    .product-name {
      font-weight: 700;
      font-size: 17px;
    }

    .product-desc {
      color: #928078;
      font-size: 12px;
      min-height: 38px;
    }

    .price {
      color: #ad7054;
      font-size: 18px;
      font-weight: 800;
    }

    .category-badge {
      background: #f9e7df;
      color: #99684f;
      font-size: 11px;
      padding: 6px 12px;
      border-radius: 20px;
    }

    .cart-box {
      background: white;
      border-radius: 23px;
      padding: 22px;
      box-shadow: 0 5px 20px #76534512;
      position: sticky;
      top: 85px;
    }

    .cart-item {
      padding: 13px 0;
      border-bottom: 1px solid #f1e9e3;
    }

    .qty-btn {
      border: none;
      background: #f8e7df;
      color: #765345;
      border-radius: 8px;
      width: 27px;
      height: 27px;
      font-weight: bold;
    }

    .remove-btn {
      border: none;
      background: #ffe5e5;
      color: #d65c5c;
      border-radius: 8px;
      padding: 5px 9px;
    }

    .payment-option {
      border: 1px solid #eadbd2;
      border-radius: 13px;
      padding: 12px;
      cursor: pointer;
      background: white;
      transition: .2s;
    }

    .payment-option:has(input:checked) {
      border: 2px solid #a87a61;
      background: #fff8f2;
    }

    .payment-option input {
      accent-color: #8b624c;
    }

    .form-control, .form-select {
      border-radius: 12px;
      padding: 11px;
    }

    .summary-box {
      background: #fff5ec;
      border-radius: 15px;
      padding: 15px;
    }

    .footer {
      background: #765345;
      color: white;
      padding: 35px 0;
      margin-top: 60px;
    }

    .empty-cart {
      text-align: center;
      color: #a8958b;
      padding: 25px 0;
    }

    .whatsapp-btn {
      background: #25d366;
      color: white;
      border: none;
      border-radius: 12px;
      padding: 13px;
      font-weight: 700;
      width: 100%;
    }

    .whatsapp-btn:hover {
      background: #1da851;
      color: white;
    }

    .stock-label {
      font-size: 11px;
      color: #77966e;
    }

    @media(max-width:767px) {
      .hero {
        padding: 45px 0;
      }
      .cart-box {
        position: static;
      }
      .product-img {
        height: 175px;
      }
    }

    @media print {
      body * {
        visibility: hidden;
      }
      #receipt, #receipt * {
        visibility: visible;
      }
      #receipt {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        padding: 15px;
        color: black;
        background: white;
      }
      .no-print {
        display: none !important;
      }
    }
  </style>
</head>

<body>

<!-- NAVBAR -->
<nav class="navbar navbar-expand-lg sticky-top no-print">
  <div class="container">
    <a class="navbar-brand" href="#">🥞 Martabak Medan</a>

    <button class="navbar-toggler" type="button"
      data-bs-toggle="collapse" data-bs-target="#menu">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="menu">
      <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-3">
        <li class="nav-item"><a class="nav-link" href="#home">Beranda</a></li>
        <li class="nav-item"><a class="nav-link" href="#produk">Produk</a></li>
        <li class="nav-item"><a class="nav-link" href="#keranjang">Keranjang</a></li>
        <li class="nav-item">
          <a class="btn soft-btn" href="#keranjang">
            🛒 Keranjang <span id="cartCount">0</span>
          </a>
        </li>
      </ul>
    </div>
  </div>
</nav>

<!-- HERO -->
<section class="hero no-print" id="home">
  <div class="container">
    <div class="row align-items-center g-4">
      <div class="col-lg-6">
        <span class="category-badge">✨ UMKM Kuliner Medan</span>
        <h1 class="mt-3">
          Nikmati Kelezatan
          <span style="color:#ad7054">Martabak</span>
          Favoritmu!
        </h1>
        <p class="mt-3">
          Selamat datang di Martabak Medan. Temukan berbagai pilihan
          martabak manis dan telur dengan rasa lezat, bahan berkualitas,
          dan harga bersahabat.
        </p>
        <a href="#produk" class="btn soft-btn mt-2">
          Lihat Menu Sekarang →
        </a>
      </div>

      <div class="col-lg-6">
        <img class="hero-img"
          src="https://images.unsplash.com/photo-1528207776546-365bb710ee93?w=900"
          alt="Martabak dan pancake lezat">
      </div>
    </div>
  </div>
</section>

<!-- KEUNGGULAN -->
<section class="container py-4 no-print">
  <div class="row g-3 text-center">
    <div class="col-4">
      <div class="p-3 rounded-4" style="background:#f8dfe0">
        <div style="font-size:27px">🥞</div>
        <b>Fresh</b>
        <div class="small">Selalu hangat</div>
      </div>
    </div>
    <div class="col-4">
      <div class="p-3 rounded-4" style="background:#dcebdc">
        <div style="font-size:27px">💝</div>
        <b>Berkualitas</b>
        <div class="small">Bahan pilihan</div>
      </div>
    </div>
    <div class="col-4">
      <div class="p-3 rounded-4" style="background:#fff0dd">
        <div style="font-size:27px">🚚</div>
        <b>Mudah</b>
        <div class="small">Pesan online</div>
      </div>
    </div>
  </div>
</section>

<!-- PRODUK -->
<section class="container py-5 no-print" id="produk">
  <div class="text-center mb-4">
    <span class="category-badge">MENU FAVORIT</span>
    <h2 class="section-title mt-2">Pilihan Martabak Kami</h2>
    <p class="text-secondary">Pilih martabak kesukaanmu dan masukkan ke keranjang.</p>
  </div>

  <div class="row g-4" id="productList">
    <!-- Produk dibuat otomatis melalui app.js -->
  </div>
</section>

<!-- KERANJANG DAN PEMBAYARAN -->
<section class="container pb-5 no-print" id="keranjang">
  <div class="row g-4">

    <div class="col-lg-7">
      <div class="cart-box">
        <h4 class="fw-bold mb-3">🛒 Keranjang Belanja</h4>
        <div id="cartItems">
          <div class="empty-cart">
            <div style="font-size:45px">🛍️</div>
            Keranjang masih kosong.
          </div>
        </div>

        <div class="summary-box mt-3">
          <div class="d-flex justify-content-between mb-2">
            <span>Total Produk</span>
            <b id="totalItems">0</b>
          </div>
          <div class="d-flex justify-content-between">
            <span>Total Pembayaran</span>
            <h5 class="fw-bold" style="color:#ad7054" id="grandTotal">
              Rp0
            </h5>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-5">
      <div class="cart-box">
        <h4 class="fw-bold mb-3">💳 Pembayaran</h4>

        <div class="mb-3">
          <label class="form-label fw-semibold">Nama Pembeli</label>
          <input type="text" id="customerName" class="form-control"
            placeholder="Masukkan nama kamu">
        </div>

        <div class="mb-3">
          <label class="form-label fw-semibold">Nomor WhatsApp</label>
          <input type="tel" id="customerPhone" class="form-control"
            placeholder="08xxxxxxxxxx">
        </div>

        <div class="mb-3">
          <label class="form-label fw-semibold">Alamat Pengiriman</label>
          <textarea id="customerAddress" class="form-control"
            rows="2" placeholder="Masukkan alamat pengiriman"></textarea>
        </div>

        <label class="form-label fw-semibold">Metode Pembayaran</label>

        <div class="d-grid gap-2 mb-3">

          <label class="payment-option">
            <input type="radio" name="payment" value="Tunai" checked>
            💵 Tunai (Cash)
          </label>

          <label class="payment-option">
            <input type="radio" name="payment" value="QRIS">
            📱 QRIS
          </label>

          <label class="payment-option">
            <input type="radio" name="payment" value="Transfer Bank">
            🏦 Transfer Bank
          </label>

        </div>

        <div id="cashSection" class="mb-3">
          <label class="form-label fw-semibold">Uang Dibayarkan</label>
          <input type="number" id="cashAmount" class="form-control"
            min="0" placeholder="Masukkan jumlah uang">

          <div class="mt-2 small" id="cashMessage">
            Masukkan uang pembayaran.
          </div>

          <div class="d-flex justify-content-between mt-2">
            <span>Kembalian</span>
            <b id="changeAmount">Rp0</b>
          </div>
        </div>

        <div id="transferSection" class="summary-box mb-3" hidden>
          <b>Informasi pembayaran</b>
          <p class="small mb-0 mt-2" id="paymentInfo"></p>
        </div>

        <button class="whatsapp-btn mb-2" onclick="checkoutWhatsApp()">
          💬 Pesan Melalui WhatsApp
        </button>

        <button class="btn btn-outline-secondary w-100 rounded-3"
          onclick="printReceipt()">
          🖨️ Cetak Nota
        </button>

        <p class="text-secondary small mt-3 mb-0 text-center">
          Pastikan pesanan dan pembayaran sudah benar.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- NOTA -->
<div id="receipt" style="display:none">
  <div class="text-center">
    <h3>🥞 MARTABAK MEDAN</h3>
    <p>Katalog UMKM Kuliner Medan</p>
    <hr>
  </div>
  <div id="receiptContent"></div>
  <hr>
  <div class="text-center">
    <b>Terima kasih telah berbelanja!</b>
    <p>Selamat menikmati ❤️</p>
  </div>
</div>

<!-- FOOTER -->
<footer class="footer text-center no-print">
  <div class="container">
    <h4 class="fw-bold">🥞 Martabak Medan</h4>
    <p class="mb-1">Kelezatan Martabak untuk Semua</p>
    <p class="small mb-0">
      Website Katalog UMKM Kuliner Medan
      <br>Proyek Pembelajaran Kelas XI RPL
      <br>SMK Negeri 9 Medan
    </p>
  </div>
</footer>

<script src="app.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
